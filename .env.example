AGENT_GATEWAY_ENVIRONMENT=development
AGENT_GATEWAY_DATABASE_URL=postgresql+psycopg://agent_gateway:agent_gateway@postgres:5432/agent_gateway
AGENT_GATEWAY_REDIS_URL=redis://redis:6379/0
AGENT_GATEWAY_RUNTIME_PROVIDER=fake
AGENT_GATEWAY_FAKE_RUNTIME_DELAY_MS=25
AGENT_GATEWAY_LOG_LEVEL=INFO
AGENT_GATEWAY_PROJECTS_DIR=./projects
AGENT_GATEWAY_WORKSPACE_ROOT=./workspaces
# Optional parent directory for self-improvement candidate outputs.
# AGENT_GATEWAY_SELF_IMPROVEMENT_ROOT=D:\workspace\codex-selfimp
AGENT_GATEWAY_KNOWLEDGE_ENABLED=false
AGENT_GATEWAY_OLLAMA_BASE_URL=http://127.0.0.1:11434
AGENT_GATEWAY_OLLAMA_EMBEDDING_MODEL=qwen3-embedding:8b
AGENT_GATEWAY_OLLAMA_MEMORY_MODEL=qwen3:14b
AGENT_GATEWAY_OLLAMA_EMBEDDING_DIMENSIONS=1024
AGENT_GATEWAY_KNOWLEDGE_ALLOWED_ROOTS=D:\workspace
AGENT_GATEWAY_KNOWLEDGE_SOURCES_DIR=D:\workspace\cag\.gateway\knowledge-sources
AGENT_GATEWAY_KNOWLEDGE_MAX_FILE_BYTES=10000000
# 本机订阅模式由 scripts/run-local-codex-gateway.ps1 设置：
# AGENT_GATEWAY_RUNTIME_PROVIDER=codex-app-server
# AGENT_GATEWAY_CODEX_EXECUTABLE=C:\path\to\codex.exe
POSTGRES_DB=agent_gateway
POSTGRES_USER=agent_gateway
POSTGRES_PASSWORD=agent_gateway
